{
	"name": "EOS SDK Development Container",
	"build": {
		"dockerfile": "../Dockerfile",
		"context": "..",
		"target": "sdk"
	},
	"forwardPorts": [8000, 9460],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cmake-tools",
				"ms-python.python",
				"redhat.ansible"
			]
		}
	}
}
